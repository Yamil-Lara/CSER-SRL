  {
    icon: CheckCircle,
    label: 'Aprobaciones',
    path: '/admin/aprobaciones',
    badge: 3
  },
  {
    icon: MessageSquare,
    label: 'Moderación',
    path: '/admin/moderacion'
  },
  {
    icon: FileText,
    label: 'Reportes PDF',
    path: '/admin/reportes'
