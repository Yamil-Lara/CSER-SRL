                                                    {p.herramientas.split(',').map((h: string, i: number) => (
                                                        <Badge key={i} variant="default" className="bg-sidebar/5 text-sidebar border-sidebar/10 text-[10px]">{h.trim()}</Badge>
                                                    ))}
