                            ) : (
                                <div className="text-slate-400 flex flex-col items-center">
                                    <span className="text-sm font-bold uppercase">Sin imagen</span>
                                </div>
                            )}
                        </div>
                    </div>

                    <div className="md:col-span-5 flex flex-col justify-center">
