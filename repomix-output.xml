                'id' => $proyecto->usuario->id,
                'nombre' => $proyecto->usuario->nombre,
                'username' => $proyecto->usuario->username,
                'foto' => $proyecto->usuario->foto ? asset('storage/' . $proyecto->usuario->foto) : null,
            ] : null,
        ];
    }
    
}
