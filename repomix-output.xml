<file path="frontend/src/App.css">
:root {
  --bg: #f2f6f9;
  --surface: #ffffff;
  --surface-strong: #f0f4f8;
  --text: #0f172a;
  --text-muted: #475569;
  --sidebar: #0f172a;
  --sidebar-contrast: #1b212f;
  --sidebar-text: #cbd5e1;
  --accent: #3b82f6;
  --accent-strong: #10bdb3;
  --danger: #f63b3b;
  --border: #e2e8f0;
  --card-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
  color-scheme: light;
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateX(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

body {
  margin: 0;
  background: var(--bg);
  overflow: hidden;
}

html,
body,
#root {
  height: 100%;
  min-height: 100vh;
}

.app-shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

.theme-dark {
  --bg: #080c17;
  --surface: #0f172a;
  --surface-strong: #1b212f;
  --text: #f8fafc;
  --text-muted: #cbd5e1;
  --sidebar: #0c1222;
  --sidebar-contrast: #080c17;
  --sidebar-text: #cbd5e1;
  --border: rgba(203, 213, 225, 0.12);
  --card-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
}

.theme-light {
  --bg: #f2f6f9;
  --surface: #ffffff;
  --surface-strong: #f0f4f8;
  --text: #0f172a;
  --text-muted: #475569;
  --sidebar: #0f172a;
  --sidebar-contrast: #1b212f;
  --sidebar-text: #cbd5e1;
  --border: #e2e8f0;
  --card-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
}

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 260px;
  height: 100vh;
  background: var(--sidebar);
  color: var(--sidebar-text);
  display: flex;
  flex-direction: column;
  padding: 2rem 1.25rem;
  transition: width 0.25s ease;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  overflow-y: auto;
  z-index: 1000;
}

.app-shell.collapsed .sidebar {
  width: 96px;
}

.app-shell.collapsed .main-content {
  margin-left: 96px;
  width: calc(100% - 96px);
}

/* Scrollbar styling */
.main-content::-webkit-scrollbar {
  width: 8px;
}

.main-content::-webkit-scrollbar-track {
  background: transparent;
}

