     * Reglas de validación
     */
    public function rules(): array
    {
        return [
            'nombre' => 'required|string|max:255',
            'username' => 'required|string|max:255|unique:usuarios,username',
            'email' => 'required|string|email|max:255|unique:usuarios,email',
            'password' => [
                'required',
