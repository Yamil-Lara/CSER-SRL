<file path="frontend/src/App.css">
:root {
  --bg: #f2f6f9;
  --surface: #ffffff;
  --surface-strong: #f0f4f8;
  --text: #0f172a;
  --text-muted: #475569;
  --sidebar: #0f172a;
  --sidebar-contrast: #1b212f;
  --sidebar-text: #cbd5e1;
  --accent: #3b82f6;
  --accent-strong: #10bdb3;
  --danger: #f63b3b;
  --border: #e2e8f0;
  --card-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
  color-scheme: light;
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateX(-10px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

body {
  margin: 0;
  background: var(--bg);
  overflow: hidden;
}

html,
body,
#root {
  height: 100%;
  min-height: 100vh;
}

.app-shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

.theme-dark {
  --bg: #080c17;
  --surface: #0f172a;
  --surface-strong: #1b212f;
  --text: #f8fafc;
  --text-muted: #cbd5e1;
  --sidebar: #0c1222;
  --sidebar-contrast: #080c17;
  --sidebar-text: #cbd5e1;
  --border: rgba(203, 213, 225, 0.12);
  --card-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
}

.theme-light {
  --bg: #f2f6f9;
  --surface: #ffffff;
  --surface-strong: #f0f4f8;
  --text: #0f172a;
  --text-muted: #475569;
  --sidebar: #0f172a;
  --sidebar-contrast: #1b212f;
  --sidebar-text: #cbd5e1;
  --border: #e2e8f0;
  --card-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
}

.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 260px;
  height: 100vh;
  background: var(--sidebar);
  color: var(--sidebar-text);
  display: flex;
  flex-direction: column;
  padding: 2rem 1.25rem;
  transition: width 0.25s ease;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  overflow-y: auto;
  z-index: 1000;
}

.app-shell.collapsed .sidebar {
  width: 96px;
}

.app-shell.collapsed .main-content {
  margin-left: 96px;
  width: calc(100% - 96px);
}

/* Scrollbar styling */
.main-content::-webkit-scrollbar {
  width: 8px;
}

.main-content::-webkit-scrollbar-track {
  background: transparent;
}

.main-content::-webkit-scrollbar-thumb {
  background: rgba(59, 130, 246, 0.3);
  border-radius: 4px;
  transition: background 0.2s ease;
}

.main-content::-webkit-scrollbar-thumb:hover {
  background: rgba(59, 130, 246, 0.5);
}

.sidebar::-webkit-scrollbar {
  width: 6px;
}

.sidebar::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

.sidebar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.25);
}

.sidebar .sidebar-top,
.sidebar .bottom {
  display: flex;
  flex-direction: column;
}

.sidebar .brand {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  margin-bottom: 2rem;
}

.brand-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.08);
  color: #3b82f6;
}

.brand-text {
  font-size: 1.35rem;
  font-weight: 700;
  color: #ffffff;
}

.app-shell.collapsed .brand-text {
  display: none;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.nav-item,
.nav-action {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.85rem 1rem;
  border-radius: 1rem;
  color: var(--sidebar-text);
  text-decoration: none;
  background: transparent;
  border: none;
  width: 100%;
  transition: background 0.2s ease, color 0.2s ease;
  cursor: pointer;
  font-size: 0.95rem;
}

.nav-item .icon,
.nav-action .icon,
.theme-toggle .icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  background: transparent;
  color: #cbd5e1;
}

.nav-item .icon svg,
.nav-action .icon svg,
.theme-toggle .icon svg,
.brand-icon svg {
  width: 18px;
  height: 18px;
}

.nav-item:hover .icon,
.nav-action:hover .icon,
.theme-toggle:hover .icon {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.sidebar .nav-item.active .icon {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.nav-item.active,
.nav-item:hover,
.nav-action:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
}

.nav-action.logout:hover {
  background: rgba(246, 59, 59, 0.18);
  color: #f63b3b;
}

.nav-item span.label,
.nav-action span.label {
  display: inline-block;
  white-space: nowrap;
}

.app-shell.collapsed .nav-item span.label,
.app-shell.collapsed .nav-action span.label {
  display: none;
}

.sidebar .separator {
  margin: 1.75rem 0 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar .bottom {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: auto;
}

.sidebar .nav-item.active,
.sidebar .nav-item:hover,
.sidebar .nav-action:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #ffffff;
}

.sidebar .nav-item.active .icon,
.sidebar .nav-item:hover .icon,
.sidebar .theme-toggle:hover .icon {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.nav-action.logout {
  color: #f63b3b;
}

.theme-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0 auto;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.theme-toggle:hover {
  transform: translateY(-1px);
}

.theme-toggle .icon {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  background: transparent;
}

.theme-toggle .icon svg {
  width: 18px;
  height: 18px;
}

.main-content {
  margin-left: 260px;
  width: calc(100% - 260px);
  height: 100vh;
  padding: 2.5rem;
  background: var(--bg);
  color: var(--text);
  overflow-y: auto;
  overflow-x: hidden;
}

.page-body {
  display: grid;
  gap: 2.2rem;
  margin-top: 1.5rem;
}

.card-section {
  border-radius: 1.75rem;
  background: var(--surface);
  box-shadow: var(--card-shadow);
  border: 1px solid var(--border);
}

.card-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.5rem 1.75rem;
  border-bottom: 1px solid var(--border);
}

.card-section-header > div {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.card-section-header h2 {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
}

.section-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
}

.section-icon svg {
  width: 22px;
  height: 22px;
}

.card-section-body {
  padding: 1.5rem 1.75rem;
}

.avatar-preview {
  display: inline-flex;
  width: 145px;
  height: 145px;
  border-radius: 28px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: #eef2ff;
  align-items: center;
  justify-content: center;
}

.avatar-preview img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  background: #eef2ff;
}

.avatar-placeholder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 2.5rem;
  color: var(--text-muted);
}

.upload-button {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.9rem 1.25rem;
  border-radius: 0.95rem;
  border: 1px solid var(--border);
  background: var(--surface-strong);
  color: var(--text);
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.upload-button:hover {
  background: var(--surface);
  border-color: var(--accent);
  color: var(--text) !important;
}

.upload-button,
.upload-button:focus {
  color: var(--text) !important;
}

.helper-text {
  margin-top: 0.5rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.page-actions {
  align-items: center;
}

.btn-outline-secondary {
  border-radius: 0.95rem;
  padding: 0.9rem 1.4rem;
}

.btn-primary {
  min-width: 170px;
  background: #3b82f6;
  border-color: #3b82f6;
  border-radius: 0.95rem;
  padding: 0.9rem 1.4rem;
}

.btn-primary:hover {
  background: #2563eb;
  border-color: #2563eb;
}

.nav-action.logout:hover {
  background: rgba(246, 59, 59, 0.16);
  color: #f63b3b;
}

.page-heading h1 {
  margin: 0;
  font-size: 2.2rem;
  font-weight: 700;
}

.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.page-subtitle {
  margin: 0.4rem 0 0;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.hamburger-menu {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 1rem;
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.hamburger-menu:hover {
  background: var(--surface-strong);
  border-color: var(--accent);
}

.hamburger-menu svg {
  width: 22px;
  height: 22px;
}

.sidebar-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.profile-card {
  border: 0;
  border-radius: 1.75rem;
  background: var(--surface);
  box-shadow: var(--card-shadow);
}

.profile-card .card-body {
  padding: 2rem;
}

.profile-summary {
  border: 1px solid var(--border);
  border-radius: 1.25rem;
  background: var(--surface-strong);
  padding: 1.25rem;
}

.profile-summary img {
  width: 100%;
  border-radius: 1rem;
  object-fit: cover;
  height: 220px;
}

.profile-summary h3 {
  margin-top: 1rem;
  margin-bottom: 0.35rem;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
}

.profile-summary p {
  margin-bottom: 0.5rem;
  color: var(--text-muted);
}

.profile-summary .profile-meta {
  margin-top: 1.25rem;
}

.profile-summary .profile-meta .meta-item {
  display: flex;
  justify-content: space-between;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.btn-primary {
  min-width: 170px;
  background: #3b82f6;
  border-color: #3b82f6;
}

.btn-primary:hover {
  background: #2563eb;
  border-color: #2563eb;
}

.form-control,
.form-control:focus,
.form-select,
.form-select:focus {
  border-radius: 0.85rem;
}

textarea.form-control {
  min-height: 110px;
}

/* Tablet y dispositivos medianos (768px a 991px) */
@media (max-width: 991px) {
  .app-shell {
    flex-direction: column;
    height: auto;
    min-height: 100vh;
  }

  .sidebar {
    position: relative;
    width: 100%;
    height: auto;
    margin-left: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-y: visible;
  }

  .main-content {
    margin-left: 0;
    width: 100%;
    height: auto;
    overflow-y: visible;
    padding: 1.5rem;
  }

  .page-heading h1 {
